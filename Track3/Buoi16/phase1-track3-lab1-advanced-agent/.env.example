# Bật LLM thật cho Actor/Evaluator/Reflector. Copy thành .env và điền giá trị.
# Nếu KHÔNG set, lab tự chạy ở chế độ mô phỏng deterministic (đủ điểm autograde).

# Bật/tắt
REFLEXION_USE_LLM=1

# Endpoint OpenAI-compatible (chọn 1):
#   OpenAI:    https://api.openai.com/v1
#   Ollama:    http://localhost:11434/v1
#   vLLM:      http://localhost:8000/v1
#   LM Studio: http://localhost:1234/v1
REFLEXION_LLM_BASE_URL=http://localhost:11434/v1

# API key (endpoint cục bộ như Ollama có thể bỏ trống). Hỗ trợ cả OPENAI_API_KEY.
REFLEXION_LLM_API_KEY=

# Tên model
REFLEXION_LLM_MODEL=llama3.1
